# This app reads the repo root's .env files, not this directory's — see
# `envDir` in vite.config.ts. The values below live in the root .env.local
# (Supabase) and the tracked root .env.production; they are listed here so a
# reader of pro-test knows what the build needs.

# Supabase project the /pro pages sign in against. Shared with the dashboard
# and with sibt.ai. The anon key is a public client value.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
