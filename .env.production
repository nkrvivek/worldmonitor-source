# Production build values. Vite loads this after .env.local, so it wins for
# `vite build` while local dev keeps whatever .env.local says.
#
# Only non-secret values belong here — the file is tracked in git.
#
# The deployed site talks to the Convex production deployment
# (benevolent-impala-683). The dev deployment (steady-snake-729) stays in
# .env.local for local work.
VITE_CONVEX_URL=https://benevolent-impala-683.convex.cloud
