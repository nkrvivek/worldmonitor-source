# =============================================================================
# Seed job runner
# =============================================================================
# One image for every scheduled seed script. worker/seeds/scheduled.ts supplies
# the entrypoint per invocation, so there is no CMD here.
#
# Whole directories are copied rather than a file list. Dockerfile.relay records
# two production breakages from cherry-picking: a script gained a local import
# and the cron died with ERR_MODULE_NOT_FOUND until someone updated the COPY
# list by hand.
# =============================================================================

FROM node:24-alpine@sha256:a0b9bf06e4e6193cf7a0f58816cc935ff8c2a908f81e6f1a95432d679c54fbfd

# _seed-utils.mjs shells out to the curl binary for sources that block Node's
# TLS fingerprint.
RUN apk add --no-cache curl

WORKDIR /app

COPY scripts/package.json scripts/package-lock.json ./scripts/
RUN npm ci --prefix scripts --omit=dev --omit=optional --ignore-scripts

COPY scripts/ ./scripts/
COPY server/ ./server/
COPY shared/ ./shared/
COPY data/ ./data/
COPY worker/counters/ ./worker/counters/
COPY tsconfig.json tsconfig.api.json ./

ENV NODE_OPTIONS="--max-old-space-size=8192 --dns-result-order=ipv4first"
